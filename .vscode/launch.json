{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API server",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open store in Chrome",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/client"
    }
  ]
}
