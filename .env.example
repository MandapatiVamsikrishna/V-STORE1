# Copy this file to ".env" (same folder) and adjust.
PORT=5000

# Leave MONGO_URI empty to use a throwaway in-memory database (wiped when the server stops).
# For a permanent database use MongoDB Atlas (free) — step-by-step in DATABASE.md:
# MONGO_URI=mongodb+srv://vstore-app:YOUR-PASSWORD@cluster0.xxxxx.mongodb.net/vstore?retryWrites=true&w=majority
MONGO_URI=

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Admin account created automatically the FIRST time the server starts with an empty database.
# Put your own email and a strong password here before that first start.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@vstore.local
ADMIN_PASSWORD=Admin@12345
